{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["index.html", "admin.html", "*.png", "*.jpg", "*.jpeg", "merch/*.png", "merch/*.jpg", "merch/*.jpeg"]
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}