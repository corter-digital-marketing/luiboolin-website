{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["*.html", "assets/*.css", "assets/*.js", "*.png", "*.jpg", "*.jpeg", "merch/*.png", "merch/*.jpg", "merch/*.jpeg", "teamphotos/*.png", "teamphotos/*.jpg", "teamphotos/*.jpeg"]
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}